# ClusterDash configuration
# Copy to .env and fill in.  NEVER commit the real .env.

# --- Login to the dashboard itself ---
ADMIN_USER=admin
# Choose a long, unique password. This is the only thing between the internet
# and root on all four of your servers.
ADMIN_PASSWORD=21021998

# --- Encryption key for stored VPS passwords ---
# Generate with:  openssl rand -base64 48
# If you lose this, stored host passwords cannot be decrypted (just re-enter them).
MASTER_KEY=change-me-generate-with-openssl-rand-base64-48

# --- Server ---
PORT=8080
# DATA_DIR is set by docker-compose.yml when running in Docker.
# Left unset, the database goes in ./data next to server.js — which is what you
# want when running locally with `npm run dev`.

# --- Polling ---
# How often each host is sampled over SSH (seconds).
POLL_INTERVAL_SECONDS=15
# How long metric history is kept (hours).
RETENTION_HOURS=48

# --- Cookies ---
# Set to 1 once you put the app behind HTTPS (Caddy/Traefik/nginx).
# Leave 0 while testing over plain http, or login will not stick.
SECURE_COOKIES=0
# Set to 1 when behind a reverse proxy so audit logs record the real client IP.
TRUST_PROXY=0
