{
  "name": "clusterdash",
  "version": "1.0.0",
  "private": true,
  "description": "Agentless SSH dashboard to manage, audit and open a console on your VPS fleet",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env server.js",
